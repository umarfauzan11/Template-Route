    "typescript",
    "dark-mode",
    "pwa"
  ],
  "author": "Umar Fauzan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/umarfauzan11/Template-Route.git"
  },
  "dependencies": {
